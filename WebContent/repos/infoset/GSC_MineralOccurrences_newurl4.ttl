<info/mo/cgdn-rdgc>
    a gxc:UICs;
    rdfs:label "CGDN Mineral Occurrence datasets"@en, "RDGC jeu de données d'indices minéralisés"@fr ;
    schema:name "CGDN Mineral Occurrence datasets"@en, "RDGC jeu de données d'indices minéralisés"@fr  ;
    gxp:haspart <info/mo/bc>,<info/mo/ab>,<info/mo/sk>,<info/mo/mb>,<info/mo/on>,<info/mo/qc>,<info/mo/nb>,<info/mo/ns>,<info/mo/nl>,<info/mo/nu>,<info/mo/nt>,<info/mo/yk>,<info/mo/nrcan-rncan>.



<info/mo/nrcan-rncan>
    a gxc:UICs;
    gxp:partof <info/mo/cgdn-rdgc>;
    rdfs:label "CGDN NRCan Mineral Occurrence datasets"@en, "RDGC jeu de données d'indices minéralisés RNCan"@fr ;
