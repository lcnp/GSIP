@base <https://geoconnex.ca/> .
@prefix gxo: <https://geoconnex.ca/info/ont/>.
@prefix gxc: <https://geoconnex.ca/id/cls/>.
@prefix gxp: <https://geoconnex.ca/id/prp/>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix owl2: <http://www.w3.org/2006/12/owl2#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gxo:geoconnex
    a owl:Ontology;
    # gxp:searchable "true";
    rdfs:label "GeoConnex Ontology"@en, "GeoConnex.ca Ontologie"@fr ;
    schema:name "GeoConnex Ontology"@en, "GeoConnex.ca Ontologie"@fr  ;
    rdfs:comment "GeoConnex ontology for representing entities in Linked SDI."@en, "Ontologie GeoConnex.ca pour la représentation des entités dans Linked SDI."@fr ;
.
 
gxc:mo
a owl:Class;
# gxp:searchable "true";
rdfs:label "Mineral Occurrence"@en,"Indice minéralisé"@fr;
rdfs:comment "GeoConnex Mineral Occurrence class. May be a single mineral occurrence (equivalent to ERML definition of mineral occurrence) or an aggregate of mineral occurrences."@en,
"Classe GeoConnex d'un indice minéralisé (équivalent à la définition d'un indice minéralisé de ERML) ou un agrégat d'occurrences minérales."@fr ;
.

gxc:UIC
a owl:Class;
owl:disjointWith gxc:FIC, gxc:IQE;
# gxp:searchable "true";
rdfs:label "Info"@en, "Info"@fr;
rdfs:comment "GeoConnex Information Content Entity class. Instances are abstract information content."@en,
"Classe GeoConnex d'information. Les instances sont une information abstraite."@fr ;
.

gxc:UICs
a owl:Class;
rdfs:subClassOf gxc:UIC ;
# gxp:searchable "true";
rdfs:label "Infoset"@en, "Infoset"@fr;
rdfs:comment "GeoConnex Infoset class. A collection of abstract information content (UICs)."@en,
"Classe GeoConnex d'un Ensemble d'information. Une collection d'information abstraite (UICs)."@fr ;
.


gxc:FIC
a owl:Class;
owl:disjointWith gxc:UIC, gxc:IQE;
# gxp:searchable "true";
rdfs:label "Data"@en, "Data"@fr;
rdfs:comment "GeoConnex Information Form Entity (data) class. Instances are formatted information (data)."@en,
"Classe GeoConnex d'informations formatées (data). Les instances sont des informations formatées (data)."@fr ;
.


gxc:FICs
a owl:Class;
rdfs:subClassOf gxc:FIC ;
# gxp:searchable "true";
rdfs:label "Dataset"@en, "Dataset"@fr;
rdfs:comment "GeoConnex Dataset class. A collection of data (FICs): formatted information content."@en,
"Classe GeoConnex d'un Ensemble de Données. Une collection de données (FICs)."@fr ;
.

gxc:IQE
a owl:Class;
owl:disjointWith gxc:UIC, gxc:FIC;
# gxp:searchable "false";
rdfs:label "Representation"@en, "Représentation"@fr;
rdfs:comment "GeoConnex Representation class. Instances are representations such as data files."@en,
"Classe GeoConnex de Représentation. Les instances sont des représentations telles que des fichiers de données."@fr ;
.


gxp:subjectOf
    a owl:ObjectProperty,owl:TransitiveProperty;
    rdfs:label "subject of"@en,"sujet de"@fr;
    rdfs:comment "GeoConnex subject of relation: between a thing and a representational entity, e.g. between a mineral occurrence and its unformatted or formatted information content or its representation (e.g. a database record, pdf file, or web page)."@en,
    "Sujet de relation GeoConnex : entre une chose et une entité représentationnelle, par exemple entre une occurrence minérale et son contenu d’information non formaté ou formaté, ou sa représentation (par exemple, un enregistrement de base de données, un fichier PDF ou une page web)."@fr;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( gxc:UIC gxc:FIC gxc:IQE)
    ] 
.

gxp:about
    a owl:ObjectProperty,owl:TransitiveProperty;
    rdfs:label "about"@en,"concernant"@fr;
    rdfs:comment "GeoConnex about relation: between a representational entity and the thing being described by the entity, e.g. between unformatted or formatted information content or a representation (e.g. a database record, pdf file, or web page) and a mineral occurrence."@en,
    "GeoConnex concernant la relation : entre une entité représentationnelle et la chose décrite par cette entité, par exemple entre un contenu d’information non formaté ou formaté, ou une représentation (par exemple, un enregistrement de base de données, un fichier PDF ou une page web) et une occurrence minérale."@fr;
    owl:inverseOf gxp:subjectOf;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( gxc:UIC gxc:FIC gxc:IQE)
    ] 
.

gxp:partOf
    a owl:ObjectProperty,owl:TransitiveProperty;
    rdfs:label "part of"@en,"partie de"@fr;
    rdfs:comment "GeoConnex part of relation: between a part and a whole, e.g. a mineral occurrence (whole) divided into smaller pieces (parts), so each piece is part of the whole."@en,
    "Partie d'une relation GeoConnex: entre une partie et son tout, ex: un indice minéralisé (tout) divisé en elements plus petits (parties), de sorte que chaque elements sont une partie de l'ensemble."@fr;
.


 
gxp:hasPart
    a owl:ObjectProperty,owl:TransitiveProperty;
    rdfs:label "has part"@en,"a comme partie"@fr;
    owl:inverseOf gxp:partOf;
    rdfs:comment "GeoConnex has part relation: between a whole and a part, e.g. a mineral occurrence (whole) divided into smaller pieces (parts), so the whole has parts that are the pieces."@en,
    "Relation GeoConnex 'a comme partie': entre un tout et une partie,  ex: un indice minéralisé (tout) divisé en elements plus petits (parties), de sorte que chaque elements sont une partie de l'ensemble."@fr;
.


gxp:concretizes
    a owl:ObjectProperty;
    rdfs:domain  gxc:IQE;
    rdfs:range [a owl:Class; owl:unionOf (gxc:UIC gxc:FIC)];
    rdfs:label "concretizes"@en,"concrétise"@fr;
    rdfs:comment "GeoConnex concretizes relation: holds between a representation and instances of info or data."@en,
    "Relation GeoConnex 'contrétise': lien entre une représentation et les instances d'une information ou d'une données."@fr;
.
 
gxp:concretizedBy
    a owl:ObjectProperty;
    rdfs:domain [a owl:Class; owl:unionOf (gxc:UIC gxc:FIC)];
    rdfs:range  gxc:IQE;
    owl:inverseOf gxp:concretizes;
    rdfs:label "concretizedBy"@en;
    rdfs:comment "GeoConnex concretizedBy relation: holds between instances of info or data and a representation."@en,
    "Relation GeoConnex contrétisé par: lien entre les instances d'une information ou d'une données et une représentation."@fr;
.

gxp:encodes
    a owl:ObjectProperty;
    rdfs:domain gxc:FIC;
    rdfs:range  gxc:UIC;
    rdfs:label "encodes"@en;
    rdfs:comment "GeoConnex encodes relation: holds between instances of data and info. Data can partially or fully encode info."@en,
    "Relation GeoConnex encode: lien entre les instances d'une information et d'une données."@fr;
.

gxp:encodedBy
    a owl:ObjectProperty;
    rdfs:domain gxc:UIC;
    rdfs:range  gxc:FIC;
    owl:inverseOf gxp:encodes;
    rdfs:label "encodedBy"@en;
    rdfs:comment "GeoConnex encoded by relation: holds between instances of info and data."@en,
    "Relation GeoConnex codé par: lien entre les instances d'une données et d'une information."@fr;
.

gxp:preferred
  a owl:DatatypeProperty;
  rdfs:label "preferred"@en, "préféré"@fr;
  rdfs:range xsd:boolean;
.

