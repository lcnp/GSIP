<info/mo/nrcan-rncan>
    a gxc:UICs;
    gxp:partOf <info/mo/cgdn-rdgc>;
    rdfs:label "CGDN NRCan Mineral Occurrence datasets"@en, "RDGC jeu de données d'indices minéralisés RNCan"@fr ;
