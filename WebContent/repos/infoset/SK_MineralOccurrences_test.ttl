    ], [
        a gxc:FICs ;
        dct:conformsTo "http://xmlns.earthresourceml.org/earthresourceml-lite/2.0" ;
        dct:format "text/csv" ;
        rdfs:label "CGDN NRCan Mineral Occurrence dataset in CSV"@en, "RDGC jeu de données d'indices minéralisés RNCan en CSV"@fr ; 
