PREFIX schema: <https://schema.org/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

_:b0    rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , _:b0;
        owl:unionOf      [ rdf:type   rdf:List , rdfs:Resource;
                           rdf:first  gxc:UIC;
                           rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                        rdf:first  gxc:FIC;
                                        rdf:rest   ()
                                      ]
                         ] .

_:b1    rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , _:b1;
        owl:unionOf      [ rdf:type   rdf:List , rdfs:Resource;
                           rdf:first  gxc:UIC;
                           rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                        rdf:first  gxc:FIC;
                                        rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                                     rdf:first  gxc:RIC;
                                                     rdf:rest   ()
                                                   ]
                                      ]
                         ] .

xsd:boolean  rdf:type    rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , xsd:boolean .

gxc:FIC  rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:comment      "Classe GeoConnex d'informations formatées (data). Les instances sont des informations formatées (data)."@fr , "GeoConnex Information Form Entity (data) class. Instances are formatted information (data)."@en;
        rdfs:label        "Data"@fr , "Data"@en;
        rdfs:subClassOf   rdfs:Resource , gxc:FIC;
        owl:disjointWith  gxc:RIC , gxc:UIC .

gxc:UIC  rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:comment      "Classe GeoConnex d'information. Les instances sont une information abstraite."@fr , "GeoConnex Information Content Entity class. Instances are abstract information content."@en;
        rdfs:label        "Info"@fr , "Info"@en;
        rdfs:subClassOf   rdfs:Resource , gxc:UIC;
        owl:disjointWith  gxc:RIC , gxc:FIC .

gxc:RIC  rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:comment      "Classe GeoConnex de Représentation. Les instances sont des représentations telles que des fichiers de données."@fr , "GeoConnex Representation class. Instances are representations such as data files."@en;
        rdfs:label        "Représentation"@fr , "Representation"@en;
        rdfs:subClassOf   rdfs:Resource , gxc:RIC;
        owl:disjointWith  gxc:FIC , gxc:UIC .

_:b2    rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , _:b2;
        owl:unionOf      [ rdf:type   rdf:List , rdfs:Resource;
                           rdf:first  gxc:UIC;
                           rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                        rdf:first  gxc:FIC;
                                        rdf:rest   ()
                                      ]
                         ] .

_:b3    rdf:type         rdfs:Class , owl:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , _:b3;
        owl:unionOf      [ rdf:type   rdf:List , rdfs:Resource;
                           rdf:first  gxc:UIC;
                           rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                        rdf:first  gxc:FIC;
                                        rdf:rest   [ rdf:type   rdf:List , rdfs:Resource;
                                                     rdf:first  gxc:RIC;
                                                     rdf:rest   ()
                                                   ]
                                      ]
                         ] .

rdf:type  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:range  rdfs:Class .

rdfs:Resource  rdf:type  rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource .

rdfs:Literal  rdf:type   rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource .

rdf:Statement  rdf:type  rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource .

rdf:nil  rdf:type  rdf:List , rdfs:Resource .

rdf:subject  rdf:type       rdf:Property , rdfs:Resource;
        rdfs:domain         rdf:Statement;
        rdfs:subPropertyOf  rdf:subject .

rdf:object  rdf:type        rdf:Property , rdfs:Resource;
        rdfs:domain         rdf:Statement;
        rdfs:subPropertyOf  rdf:object .

rdf:predicate  rdf:type     rdf:Property , rdfs:Resource;
        rdfs:domain         rdf:Statement;
        rdfs:subPropertyOf  rdf:predicate .

rdf:first  rdf:type         rdf:Property , rdfs:Resource;
        rdfs:domain         rdf:List;
        rdfs:subPropertyOf  rdf:first .

rdf:rest  rdf:type          rdf:Property , rdfs:Resource;
        rdfs:domain         rdf:List;
        rdfs:range          rdf:List;
        rdfs:subPropertyOf  rdf:rest .

rdfs:subPropertyOf  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:domain  rdf:Property;
        rdfs:range   rdf:Property .

rdfs:subClassOf  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:domain  rdfs:Class;
        rdfs:range   rdfs:Class .

rdfs:domain  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:domain  rdf:Property;
        rdfs:range   rdfs:Class .

rdfs:range  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:domain  rdf:Property;
        rdfs:range   rdfs:Class .

rdfs:comment  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:range  rdfs:Literal .

rdfs:label  rdf:type  rdf:Property , rdfs:Resource;
        rdfs:range  rdfs:Literal .

rdf:XMLLiteral  rdf:type  rdfs:Datatype , rdfs:Class , rdfs:Resource .

rdf:List  rdf:type       rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource .

rdfs:Class  rdf:type     rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , rdfs:Class .

rdf:Property  rdf:type   rdfs:Class , rdfs:Resource;
        rdfs:subClassOf  rdfs:Resource , rdf:Property .

