gxp:preferred  rdf:type  owl:DatatypeProperty , rdf:Property , rdfs:Resource;
        rdfs:label  "préféré"@fr , "preferred"@en;
        rdfs:range  xsd:boolean .

gxp:encodedBy  rdf:type  owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment   "Relation GeoConnex codé par: lien entre les instances d'une données et d'une information."@fr , "GeoConnex encoded by relation: holds between instances of info and data."@en;
        rdfs:domain    gxc:UIC;
        rdfs:label     "encodedBy"@en;
        rdfs:range     gxc:FIC;
        owl:inverseOf  gxp:encodes .

gxp:encodes  rdf:type  owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment  "Relation GeoConnex encode: lien entre les instances d'une information et d'une données."@fr , "GeoConnex encodes relation: holds between instances of data and info. Data can partially or fully encode info."@en;
        rdfs:domain   gxc:FIC;
        rdfs:label    "encodes"@en;
        rdfs:range    gxc:UIC .

gxp:representedBy  rdf:type  owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment   "Relation GeoConnex contrétisé par: lien entre les instances d'une information ou d'une données et une représentation."@fr , "GeoConnex representedBy relation: holds between instances of info or data and a representation."@en;
        rdfs:domain    _:b0;
        rdfs:label     "representedBy"@en;
        rdfs:range     gxc:RIC;
        owl:inverseOf  gxp:represents .

gxp:represents  rdf:type  owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment  "Relation GeoConnex 'contrétise': lien entre une représentation et les instances d'une information ou d'une données."@fr , "GeoConnex represents relation: holds between a representation and instances of info or data."@en;
        rdfs:domain   gxc:RIC;
        rdfs:label    "concrétise"@fr , "represents"@en;
        rdfs:range    _:b2 .

gxp:hasPart  rdf:type  owl:ObjectProperty;
        rdfs:comment   "Relation GeoConnex 'a comme partie': entre un tout et une partie,  ex: un indice minéralisé (tout) divisé en elements plus petits (parties), de sorte que chaque elements sont une partie de l'ensemble."@fr , "GeoConnex has part relation: between a whole and a part, e.g. a mineral occurrence (whole) divided into smaller pieces (parts), so the whole has parts that are the pieces."@en;
        rdfs:label     "a comme partie"@fr , "has part"@en;
        owl:inverseOf  gxp:partOf .

gxp:partOf  rdf:type  owl:TransitiveProperty , owl:ObjectProperty;
        rdfs:comment  "Partie d'une relation GeoConnex: entre une partie et son tout, ex: un indice minéralisé (tout) divisé en elements plus petits (parties), de sorte que chaque elements sont une partie de l'ensemble."@fr , "GeoConnex part of relation: between a part and a whole, e.g. a mineral occurrence (whole) divided into smaller pieces (parts), so each piece is part of the whole."@en;
        rdfs:label    "partie de"@fr , "part of"@en .

gxp:about  rdf:type    owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment   "GeoConnex concernant la relation : entre une entité représentationnelle et la chose décrite par cette entité, par exemple entre un contenu d’information non formaté ou formaté, ou une représentation (par exemple, un enregistrement de base de données, un fichier PDF ou une page web) et une occurrence minérale."@fr , "GeoConnex about relation: between a representational entity and the thing being described by the entity, e.g. between unformatted or formatted information content or a representation (e.g. a database record, pdf file, or web page) and a mineral occurrence."@en;
        rdfs:domain    _:b1;
        rdfs:label     "concernant"@fr , "about"@en;
        owl:inverseOf  gxp:subjectOf .

gxp:subjectOf  rdf:type  owl:ObjectProperty , rdf:Property , rdfs:Resource;
        rdfs:comment  "Sujet de relation GeoConnex : entre une chose et une entité représentationnelle, par exemple entre une occurrence minérale et son contenu d’information non formaté ou formaté, ou sa représentation (par exemple, un enregistrement de base de données, un fichier PDF ou une page web)."@fr , "GeoConnex subject of relation: between a thing and a representational entity, e.g. between a mineral occurrence and its unformatted or formatted information content or its representation (e.g. a database record, pdf file, or web page)."@en;
        rdfs:label    "sujet de"@fr , "subject of"@en;
        rdfs:range    _:b3 .

gxc:FICs  rdf:type       owl:Class , rdfs:Class , rdfs:Resource;
        rdfs:comment     "Classe GeoConnex d'un Ensemble de Données. Une collection de données (FICs)."@fr , "GeoConnex Dataset class. A collection of data (FICs): formatted information content."@en;
        rdfs:label       "Dataset"@fr , "Dataset"@en;
        rdfs:subClassOf  gxc:FIC , gxc:FICs , rdfs:Resource .

gxc:UICs  rdf:type       owl:Class , rdfs:Class , rdfs:Resource;
        rdfs:comment     "Classe GeoConnex d'un Ensemble d'information. Une collection d'information abstraite (UICs)."@fr , "GeoConnex Infoset class. A collection of abstract information content (UICs)."@en;
        rdfs:label       "Infoset"@fr , "Infoset"@en;
        rdfs:subClassOf  gxc:UIC , gxc:UICs , rdfs:Resource .

gxc:mo  rdf:type      owl:Class , rdfs:Class , rdfs:Resource;
        rdfs:comment  "Classe GeoConnex d'un indice minéralisé (équivalent à la définition d'un indice minéralisé de ERML) ou un agrégat d'occurrences minérales."@fr , "GeoConnex Mineral Occurrence class. May be a single mineral occurrence (equivalent to ERML definition of mineral occurrence) or an aggregate of mineral occurrences."@en;
        rdfs:label    "Indice minéralisé"@fr , "Mineral Occurrence"@en .

gxo:geoconnex.ca  rdf:type  owl:Ontology;
        rdfs:comment   "Ontologie Geoconnex.ca pour la représentation des entités dans Linked SDI."@fr , "Geoconnex.ca ontology for representing entities in linked SDI."@en;
        rdfs:label     "Geoconnex.ca ontologie"@fr , "Geoconnex.ca ontology"@en;
        gxp:subjectOf  [ rdf:type           gxc:FICs , _:b3 , _:b0 , gxc:FIC , rdfs:Resource;
                         rdfs:label         "Ontologie Geoconnex.ca en ttl"@fr , "Geoconnex.ca ontology in ttl"@en;
                         dct:conformsTo     owl:;
                         dct:format         "text/turtle";
                         gxp:representedBy  [ rdf:type         gxc:RIC , rdfs:Resource;
